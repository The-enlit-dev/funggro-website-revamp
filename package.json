{
  "name": "funngro-website-revamp",
  "version": "1.0.0",
  "private": true,
  "description": "Static two-page redesign of Funngro (Teen /earn and Company /about).",
  "type": "module",
  "scripts": {
    "images": "node scripts/images.mjs",
    "fonts": "node scripts/fonts.mjs",
    "build": "node scripts/build.mjs",
    "build:production": "DEPLOY_TARGET=production SITE_URL=https://www.funngro.com node scripts/build.mjs",
    "serve": "npx serve dist -l 4173",
    "test": "node tests/run-all.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "axe-core": "^4.14.1",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "lightningcss": "1.30",
    "qrcode": "1.5",
    "sharp": "^0.34.5"
  }
}
